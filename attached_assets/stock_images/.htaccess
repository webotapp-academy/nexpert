# Prevent caching of deleted images
<FilesMatch "professional_busines_a5bb892c\.jpg">
    # Return 404 for this specific image
    Order allow,deny
    Deny from all
</FilesMatch>

# Cache control for stock images
<IfModule mod_headers.c>
    # Short cache time to allow quick updates
    Header set Cache-Control "max-age=3600, must-revalidate"
</IfModule>

# Disable directory listing
Options -Indexes
